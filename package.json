{
  "name": "ledgerly",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "test": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:all": "npm run test && npm run test:integration",
    "db:migrate": "prisma migrate dev",
    "db:seed": "tsx prisma/seed.ts",
    "db:reset": "prisma migrate reset --force",
    "e2e": "node scripts/e2e.mjs",
    "e2e:tx-detail": "node scripts/e2e-tx-detail.mjs",
    "e2e:mobile-nav": "node scripts/e2e-mobile-nav.mjs",
    "e2e:analytics": "node scripts/e2e-analytics.mjs",
    "e2e:dashboard": "node scripts/e2e-dashboard.mjs",
    "e2e:accounts": "node scripts/e2e-accounts.mjs",
    "e2e:bills": "node scripts/e2e-bills.mjs",
    "e2e:budgets": "node scripts/e2e-budgets.mjs",
    "e2e:activity": "node scripts/e2e-activity.mjs",
    "e2e:import": "node scripts/e2e-import.mjs",
    "e2e:recurring": "node scripts/e2e-recurring.mjs",
    "e2e:backup-restore": "node scripts/e2e-backup-restore.mjs",
    "e2e:monito": "node scripts/e2e-monito.mjs",
    "e2e:large-import": "node scripts/e2e-large-import.mjs",
    "e2e:perf": "node scripts/e2e-perf.mjs",
    "e2e:offline": "tsx scripts/offline-p0-replay.ts && node scripts/e2e-offline.mjs && node scripts/e2e-offline-p2.mjs && tsx scripts/e2e-offline-p2-softheal.ts && tsx scripts/e2e-offline-p3.ts",
    "e2e:collab": "tsx scripts/e2e-collab-foundation.ts && tsx scripts/e2e-collab-ui.ts && tsx scripts/e2e-collab-offline.ts",
    "e2e:audit-phaseA": "tsx scripts/e2e-toctou-race.ts && tsx scripts/e2e-phaseA-ui.ts",
    "e2e:group-expenses": "tsx scripts/e2e-group-expenses.ts",
    "e2e:datepicker": "node scripts/e2e-datepicker.mjs",
    "e2e:lending": "tsx scripts/e2e-lending.ts",
    "e2e:lending-settlement": "tsx scripts/e2e-lending-settlement.ts",
    "e2e:finance-hub": "tsx scripts/e2e-finance-hub.ts",
    "e2e:accessibility": "tsx scripts/e2e-accessibility.ts",
    "e2e:all": "npm run db:seed && npm run e2e && npm run e2e:tx-detail && npm run e2e:mobile-nav && npm run e2e:analytics && npm run e2e:dashboard && npm run e2e:accounts && npm run e2e:bills && npm run e2e:budgets && npm run e2e:activity && npm run e2e:import && npm run e2e:recurring && npm run e2e:backup-restore && npm run e2e:monito && npm run e2e:large-import && npm run e2e:perf && npm run e2e:offline && npm run e2e:collab && npm run e2e:audit-phaseA && npm run e2e:group-expenses && npm run e2e:datepicker && npm run e2e:lending && npm run e2e:lending-settlement && npm run e2e:finance-hub && npm run e2e:accessibility"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.10.0",
    "@upstash/ratelimit": "^2.0.8",
    "@upstash/redis": "^1.38.0",
    "better-auth": "^1.2.0",
    "exceljs": "^4.4.0",
    "next": "^15.3.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "resend": "^6.17.2",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@tailwindcss/postcss": "^4.1.0",
    "@types/node": "^22",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv": "^16.6.1",
    "eslint": "^9.39.5",
    "eslint-config-next": "^15.5.20",
    "playwright": "^1.61.1",
    "prisma": "^6.10.0",
    "tailwindcss": "^4.1.0",
    "tsx": "^4.19.0",
    "typescript": "^5.8.0",
    "vitest": "^3.1.0"
  }
}
