    "smoke:groups": "tsx scripts/smoke-group-invariants.ts",
    "e2e": "node scripts/db-local.mjs --shell \"node scripts/e2e.mjs\"",
    "e2e:tx-detail": "node scripts/db-local.mjs --shell \"node scripts/e2e-tx-detail.mjs\"",
