    "e2e:composer-edit": "node scripts/db-local.mjs --shell \"tsx scripts/e2e-composer-edit.ts\"",
    "e2e:entry-points": "node scripts/db-local.mjs --shell \"tsx scripts/e2e-entry-points.ts\"",
    "e2e:simplify-control": "node scripts/db-local.mjs --shell \"tsx scripts/e2e-simplify-control.ts\"",
