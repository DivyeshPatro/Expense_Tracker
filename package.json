    "e2e:modal-footer": "node scripts/db-local.mjs --shell \"tsx scripts/e2e-modal-footer.ts\"",
    "e2e:composer": "node scripts/db-local.mjs --shell \"tsx scripts/e2e-composer.ts\"",
    "e2e:composer-audit": "node scripts/db-local.mjs --shell \"tsx scripts/e2e-composer-audit.ts\"",
