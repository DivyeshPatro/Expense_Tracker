{
  "name": "ledgerly",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "test": "vitest run",
    "db:migrate": "prisma migrate dev",
    "db:seed": "tsx prisma/seed.ts",
    "db:reset": "prisma migrate reset --force",
    "e2e": "node scripts/e2e.mjs",
    "e2e:tx-detail": "node scripts/e2e-tx-detail.mjs",
    "e2e:mobile-nav": "node scripts/e2e-mobile-nav.mjs",
    "e2e:import": "node scripts/e2e-import.mjs",
    "e2e:monito": "node scripts/e2e-monito.mjs",
    "e2e:large-import": "node scripts/e2e-large-import.mjs",
    "e2e:perf": "node scripts/e2e-perf.mjs",
    "e2e:all": "npm run db:seed && npm run e2e && npm run e2e:tx-detail && npm run e2e:mobile-nav && npm run e2e:import && npm run e2e:monito && npm run e2e:large-import && npm run e2e:perf"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.10.0",
    "better-auth": "^1.2.0",
    "next": "^15.3.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "xlsx": "^0.18.5",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.0",
    "@types/node": "^22",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "playwright": "^1.61.1",
    "prisma": "^6.10.0",
    "tailwindcss": "^4.1.0",
    "tsx": "^4.19.0",
    "typescript": "^5.8.0",
    "vitest": "^3.1.0"
  }
}
