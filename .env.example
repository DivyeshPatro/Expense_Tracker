# Postgres connection string.
# Local dev: postgresql://postgres@127.0.0.1:5432/ledgerly
# Supabase: use the pooled (PgBouncer) connection string from the dashboard.
DATABASE_URL="postgresql://postgres@127.0.0.1:5432/ledgerly"

# Better Auth — generate with: openssl rand -hex 32
BETTER_AUTH_SECRET=""
BETTER_AUTH_URL="http://localhost:3000"

# Shared secret for the daily cron route (/api/cron/daily)
CRON_SECRET=""

# Resend — transactional email (password reset). Get a key at resend.com;
# RESEND_FROM must be on a domain verified there, or leave unset to use
# their shared onboarding@resend.dev sender for testing. Reset flow degrades
# gracefully (logs the link server-side instead of emailing it) if unset.
RESEND_API_KEY=""
RESEND_FROM=""
