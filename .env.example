# Postgres connection string.
# Local dev: postgresql://postgres@127.0.0.1:5432/ledgerly
# Supabase: use the pooled (PgBouncer) connection string from the dashboard.
DATABASE_URL="postgresql://postgres@127.0.0.1:5432/ledgerly"

# Better Auth — generate with: openssl rand -hex 32
BETTER_AUTH_SECRET=""
BETTER_AUTH_URL="http://localhost:3000"

# Shared secret for the daily cron route (/api/cron/daily)
CRON_SECRET=""

# Resend — transactional email (password reset). Get a key at resend.com;
# RESEND_FROM must be on a domain verified there, or leave unset to use
# their shared onboarding@resend.dev sender for testing. Reset flow degrades
# gracefully (logs the link server-side instead of emailing it) if unset.
RESEND_API_KEY=""
RESEND_FROM=""

# Upstash Redis — rate limiting for sign-in/sign-up/password-reset-request
# (src/server/rate-limit.ts). Create a free database at upstash.com and copy
# both values from its dashboard. Without these set, rate limiting is a
# no-op (fails open) rather than blocking everything.
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# Registration is CLOSED by default. Ledgerly is single-tenant: one deployment
# holds one person's finances and their saved card details, so an open sign-up
# page on a public URL lets a stranger create an account inside it.
#
# To create the first account: set this to true, register, then remove it again.
# Anything other than the exact string "true" leaves registration closed.
ALLOW_SIGNUP=""
