// Ledgerly — full schema across all phases (migrate once, per Architecture doc §4).
// All money fields are integer paise (₹1 = 100). Never floats.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ───────────────────────── Auth (Better Auth) ─────────────────────────

model User {
  id            String   @id @default(cuid())
  name          String
  email         String   @unique
  emailVerified Boolean  @default(false)
  image         String?
  currency      String   @default("INR")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  sessions        Session[]
  authAccounts    AuthAccount[]
  accounts        Account[]
  transactions    Transaction[]
  categories      Category[]
  budgets         Budget[]
  bills           Bill[]
  recurringRules  RecurringRule[]
  tags            Tag[]
  participants    Participant[]
  settlements     Settlement[]
  notifications   Notification[]
  merchantRules   MerchantRule[]
  importBatches   ImportBatch[]
  loanEntries     LoanEntry[]
  loanAllocations LoanAllocation[]
}

model Session {
  id        String   @id @default(cuid())
  expiresAt DateTime
  token     String   @unique
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

model AuthAccount {
  id                    String    @id @default(cuid())
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
}

model Verification {
  id         String   @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

// ───────────────────────── Phase 1 — Personal ledger ─────────────────────────

enum AccountType {
  BANK
  CASH
  WALLET
  CREDIT_CARD
  INVESTMENT
}

model Account {
  id             String      @id @default(cuid())
  userId         String
  user           User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  name           String // "HDFC Savings"
  type           AccountType
  bankName       String?
  openingBalance BigInt      @default(0) // paise
  balance        BigInt      @default(0) // maintained in-tx, rebuildable from openingBalance + Σ ledger
  color          String?
  icon           String?
  isArchived     Boolean     @default(false)
  createdAt      DateTime    @default(now())
  // lending-module-phase1: Card Vault (spec-approved Phase 1 scope) — only
  // meaningful when type == CREDIT_CARD. No encrypted storage yet, by design;
  // last4/network are display-only, never a full card number.
  cardNetwork    String?
  cardLast4      String?
  statementDay   Int? // day-of-month the statement cuts
  dueDay         Int? // day-of-month payment is due

  transactionsFrom Transaction[] @relation("txAccount")
  transactionsTo   Transaction[] @relation("txToAccount")
  budgets          Budget[]
  loanEntries      LoanEntry[]

  @@index([userId])
}

enum TxType {
  EXPENSE
  INCOME
  TRANSFER
}

model Transaction {
  id                  String           @id @default(cuid())
  userId              String // who recorded it
  user                User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  type                TxType
  amount              BigInt // paise, always positive
  accountId           String? // source account (null: paid by someone else)
  account             Account?         @relation("txAccount", fields: [accountId], references: [id])
  toAccountId         String? // TRANSFER only
  toAccount           Account?         @relation("txToAccount", fields: [toAccountId], references: [id])
  categoryId          String?
  category            Category?        @relation(fields: [categoryId], references: [id])
  merchant            String
  occurredAt          DateTime
  notes               String?
  location            String?
  paymentMethod       String?
  isRecurring         Boolean          @default(false)
  recurringRuleId     String?
  importBatchId       String?
  // collaboration-architecture-rfc §1/§8: when set, this transaction is
  // editable by any authorized member of the group, not just `userId` — a
  // group deletion orphans the transaction back to a personal record rather
  // than destroying real financial history (SetNull, same pattern as
  // categoryId's existing soft-heal precedent)
  groupId             String?
  group               Group?           @relation(fields: [groupId], references: [id], onDelete: SetNull)
  paidByParticipantId String? // null ⇒ paid by owner
  paidBy              Participant?     @relation("paidBy", fields: [paidByParticipantId], references: [id])
  splits              ExpenseSplit[]
  tags                TransactionTag[]
  receipts            Receipt[]
  deletedAt           DateTime? // soft delete → undo
  createdAt           DateTime         @default(now())
  version             Int              @default(1) // bumped on every update — offline sync's conflict check (offline-sync-spec §4.2)

  @@index([userId, occurredAt(sort: Desc)])
  @@index([userId, categoryId])
  @@index([userId, accountId])
  @@index([userId, merchant])
  @@index([importBatchId])
  @@index([groupId])
}

/// Offline-sync idempotency ledger (offline-sync-spec §4.2/§4.3): one row per
/// applied client intent, inserted inside the same $transaction as the
/// mutation. Unique (userId, id) makes at-least-once delivery exactly-once.
/// Not history (audit is history) — pruned after 30 days by a later phase.
model Intent {
  id         String // client-generated intentId (uuid v4)
  userId     String
  deviceId   String
  deviceName String? // UA-derived friendly name (offline-sync-spec §13 OK_OVERRIDE copy: "replaced an edit from {device}") — Phase 3
  kind       String // "expense.create" | ... (one per action brought into scope)
  entityId   String
  status     String // applied | overridden | failed
  error      String?
  clientTs   DateTime
  appliedAt  DateTime @default(now())

  @@id([userId, id])
  @@index([userId, appliedAt])
  @@index([userId, entityId, appliedAt]) // Phase 3: "who last touched this entity" for LWW override copy
  // collaboration-architecture-rfc §6.1: checkOverride's "most recent Intent
  // for this entity" lookup drops the userId filter once a second writer can
  // exist — the (userId, entityId, appliedAt) index above can't serve an
  // entityId-only query efficiently since userId is its leading column
  @@index([entityId, appliedAt])
}

// group-expenses-sprint: a category is EITHER personal (userId set, groupId
// null) OR group-owned (groupId set, userId null) — never both. Group
// categories belong to the group, not their creator: they survive the
// creator leaving (no cascade tied to any one member), are visible only to
// that group, and never appear in anyone's personal category list. Postgres
// treats NULL as distinct for uniqueness, so the two @@unique constraints
// below never interact — a group category's userId is always NULL and so
// never collides with any personal @@unique([userId,...]) row, and vice versa.
model Category {
  id       String  @id @default(cuid())
  userId   String?
  user     User?   @relation(fields: [userId], references: [id], onDelete: Cascade)
  groupId  String?
  group    Group?  @relation(fields: [groupId], references: [id], onDelete: Cascade)
  name     String // seeded defaults + custom
  kind     TxType // EXPENSE or INCOME
  parentId String? // subcategories
  icon     String?
  color    String?

  transactions  Transaction[]
  budgets       Budget[]
  merchantRules MerchantRule[]

  @@unique([userId, name, kind])
  @@unique([groupId, name, kind])
  @@index([groupId])
}

// Rule-based auto-categorization: merchant → category, self-improving on re-categorization.
model MerchantRule {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  merchant   String // normalized lowercase
  categoryId String
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  hits       Int      @default(1)
  updatedAt  DateTime @updatedAt

  @@unique([userId, merchant])
}

enum BudgetPeriod {
  WEEKLY
  MONTHLY
  YEARLY
}

model Budget {
  id         String       @id @default(cuid())
  userId     String
  user       User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  categoryId String? // null ⇒ overall budget
  category   Category?    @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  accountId  String? // account-scoped budgets
  account    Account?     @relation(fields: [accountId], references: [id], onDelete: Cascade)
  period     BudgetPeriod @default(MONTHLY)
  limit      BigInt // paise
  alertAt    Int          @default(80) // % threshold notification

  @@unique([userId, categoryId, accountId, period])
}

enum BillStatus {
  UPCOMING
  PAID
  OVERDUE
}

enum Cadence {
  DAILY
  WEEKLY
  MONTHLY
  QUARTERLY
  YEARLY
}

model Bill {
  id              String     @id @default(cuid())
  userId          String
  user            User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  name            String
  amount          BigInt // paise
  categoryId      String?
  accountId       String? // default account to pay from
  dueDate         DateTime
  cadence         Cadence? // null ⇒ one-off; else due date rolls forward on payment
  recurringRuleId String?
  status          BillStatus @default(UPCOMING)
  paidTxId        String? // links the payment transaction

  @@index([userId, dueDate])
}

enum RuleKind {
  TRANSACTION
  BILL
}

model RecurringRule {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  cadence   Cadence
  interval  Int       @default(1)
  nextRunAt DateTime
  endsAt    DateTime?
  // Day-of-month the schedule is pinned to, for month-based cadences. Without
  // it, advancing from an already-clamped date makes month-end schedules drift
  // down permanently (31st → Feb 28 → Mar 28 → …). Null on pre-existing rules,
  // which keeps their current behaviour — see advance() in lib/dates.ts.
  anchorDay Int?
  // Paused rules are skipped by the engine and their nextRunAt does NOT advance
  // while paused — resuming rolls the schedule forward to the next future
  // occurrence rather than backfilling the pause window.
  isPaused  Boolean   @default(false)
  template  Json // transaction/bill payload to materialize
  kind      RuleKind

  @@index([nextRunAt])
  @@index([userId])
}

model Tag {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  name   String

  transactions TransactionTag[]

  @@unique([userId, name])
}

model TransactionTag {
  txId  String
  tx    Transaction @relation(fields: [txId], references: [id], onDelete: Cascade)
  tagId String
  tag   Tag         @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([txId, tagId])
}

model Receipt {
  id          String      @id @default(cuid())
  txId        String
  tx          Transaction @relation(fields: [txId], references: [id], onDelete: Cascade)
  userId      String
  storagePath String
  mimeType    String
  sizeBytes   Int
  uploadedAt  DateTime    @default(now())

  @@index([txId])
  @@index([userId])
}

// ───────────────────────── Phase 2 — Shared ─────────────────────────

// A person you split with. linkedUserId is set when they join via invitation —
// you can split with "Rohan" before Rohan ever signs up.
model Participant {
  id           String  @id @default(cuid())
  ownerId      String // whose contact list
  owner        User    @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  displayName  String
  color        String?
  linkedUserId String?
  // lending-module-phase1: Contacts screen fields — optional, additive.
  // Shared Expenses never reads or writes these; only Lending's Contact UI does.
  photo        String?
  phone        String?
  notes        String?

  splits       ExpenseSplit[]
  paidTx       Transaction[]  @relation("paidBy")
  groupMembers GroupMember[]
  settlements  Settlement[]
  loanEntries  LoanEntry[]

  @@index([ownerId])
  // collaboration-architecture-rfc §9: hot path for "which groups is this
  // real user authorized in" — resolveGroupRole() joins through this on
  // every group-transaction request
  @@index([linkedUserId])
}

enum GroupRole {
  OWNER
  ADMIN
  MEMBER
}

model Group {
  id           String        @id @default(cuid())
  name         String
  createdById  String // implicit OWNER — no GroupMember row for the creator (collaboration-architecture-rfc §3.1)
  members      GroupMember[]
  transactions Transaction[]
  invitations  Invitation[]
  categories   Category[] // group-expenses-sprint: the group's own EXPENSE category namespace

  @@index([createdById])
}

model GroupMember {
  groupId       String
  group         Group       @relation(fields: [groupId], references: [id], onDelete: Cascade)
  participantId String
  participant   Participant @relation(fields: [participantId], references: [id], onDelete: Cascade)
  role          GroupRole   @default(MEMBER)

  @@id([groupId, participantId])
}

enum InviteStatus {
  PENDING
  ACCEPTED
  EXPIRED
}

model Invitation {
  id            String       @id @default(cuid())
  email         String
  invitedById   String
  participantId String
  token         String       @unique
  status        InviteStatus @default(PENDING)
  expiresAt     DateTime
  // collaboration-architecture-rfc §9: when set, accepting this invitation
  // atomically grants group membership at `role` alongside the existing
  // linkedUserId link — plain 1:1 friend invitations leave both null,
  // unchanged from today
  groupId       String?
  group         Group?       @relation(fields: [groupId], references: [id], onDelete: SetNull)
  role          GroupRole?

  @@index([groupId])
}

enum SplitMethod {
  EQUAL
  PERCENT
  EXACT
  RATIO
  CUSTOM
}

// Truth = exact paise per head; Σ owedAmount per tx equals tx.amount
// (enforced by a DB trigger added in the initial migration).
model ExpenseSplit {
  id            String       @id @default(cuid())
  txId          String
  tx            Transaction  @relation(fields: [txId], references: [id], onDelete: Cascade)
  participantId String? // null ⇒ the owner's own share
  participant   Participant? @relation(fields: [participantId], references: [id])
  owedAmount    BigInt // paise
  method        SplitMethod  @default(EQUAL)
  isSettled     Boolean      @default(false)

  @@index([participantId, isSettled])
  @@index([txId])
}

enum SettleMethod {
  UPI
  CASH
  BANK
}

enum SettleDirection {
  TO_OWNER // participant paid the owner back
  FROM_OWNER // owner paid the participant back
}

model Settlement {
  id            String          @id @default(cuid())
  userId        String // owner whose ledger this settles
  user          User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  participantId String
  participant   Participant     @relation(fields: [participantId], references: [id], onDelete: Cascade)
  direction     SettleDirection
  amount        BigInt // paise
  method        SettleMethod
  settledAt     DateTime        @default(now())
  note          String?

  @@index([userId, settledAt(sort: Desc)])
}

// ───────────────────────── Lending module (Phase 1) ─────────────────────────
// Personal, not collaborative — one owner's private ledger with a contact,
// reusing Participant rather than a second person model. A single signed
// running balance per participant (Σ GAVE − Σ GOT), same sign convention as
// netBalances() (positive = they owe you): "You Gave" always means money
// moved from the owner to the contact (a fresh loan OR repaying money the
// owner borrowed); "You Got" always means money moved from the contact to
// the owner (a repayment received OR money the owner borrowed). No separate
// direction enum, no separate Loan-vs-Repayment object — lending-module-rfc
// §1 (forward-compatible: Phase 2's per-loan FIFO allocation adds a join
// table over GAVE rows, additive, not a rework of this table).
enum LoanEntryKind {
  GAVE
  GOT
}

model LoanEntry {
  id            String        @id @default(cuid())
  userId        String
  user          User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  participantId String
  participant   Participant   @relation(fields: [participantId], references: [id], onDelete: Cascade)
  kind          LoanEntryKind
  amount        BigInt // paise, always positive
  accountId     String? // funding source — null ⇒ untracked/cash-in-hand
  account       Account?      @relation(fields: [accountId], references: [id], onDelete: SetNull)
  reason        String?
  notes         String?
  dueDate       DateTime? // meaningful for GAVE rows; Phase 2 billing intelligence reads this
  occurredAt    DateTime
  deletedAt     DateTime? // soft delete → undo, same pattern as Transaction
  createdAt     DateTime      @default(now())
  version       Int           @default(1) // offline sync conflict check, same pattern as Transaction

  // lending-module-phase2: a GAVE row's settled/remaining/status is always
  // DERIVED from its allocations (Σ vs amount), never stored — see
  // LoanAllocation's own doc comment.
  allocationsAsGave LoanAllocation[] @relation("allocationsAgainstGave")
  allocationsAsGot  LoanAllocation[] @relation("allocationsFromGot")

  @@index([userId, occurredAt(sort: Desc)])
  @@index([userId, participantId])
  @@index([accountId])
}

// lending-module-phase2: settlement engine — a GOT (repayment) entry can be
// allocated across one or more prior GAVE (loan) entries for the same
// contact. Purely additive over Phase 1's flat ledger: LoanEntry itself is
// untouched, and a loan's settled/remaining/status is always computed from
// Σ allocations vs. amount (never a stored column), so it can't drift out of
// sync. Soft-deleting either side of a pair is enough to correct settlement
// math at read time — the same precedent Transaction/ExpenseSplit already
// use (children are read-time filtered through their parent's deletedAt,
// never specially cascaded) — so no cascade logic is needed here either.
model LoanAllocation {
  id          String    @id @default(cuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  gaveEntryId String
  gaveEntry   LoanEntry @relation("allocationsAgainstGave", fields: [gaveEntryId], references: [id], onDelete: Cascade)
  gotEntryId  String
  gotEntry    LoanEntry @relation("allocationsFromGot", fields: [gotEntryId], references: [id], onDelete: Cascade)
  amount      BigInt // paise, portion of gotEntry applied to gaveEntry
  createdAt   DateTime  @default(now())

  @@index([userId, gaveEntryId])
  @@index([gaveEntryId])
  @@index([gotEntryId])
}

enum NotifKind {
  BUDGET_EXCEEDED
  BUDGET_WARNING
  BILL_DUE
  SETTLE_REMINDER
  RECURRING_CREATED
  MONTHLY_SUMMARY
  LARGE_EXPENSE
}

model Notification {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  kind      NotifKind
  payload   Json
  dedupeKey String? // e.g. "budget:<id>:2026-07:100" → exactly-once per budget per period
  readAt    DateTime?
  createdAt DateTime  @default(now())

  @@unique([userId, dedupeKey])
  @@index([userId, readAt])
}

// ───────────────────────── Phase 3 — Import & audit ─────────────────────────

enum ImportStatus {
  PREVIEW
  COMMITTED
  UNDONE
}

model ImportBatch {
  id            String       @id @default(cuid())
  userId        String
  user          User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  source        String // "monito" | "csv" | "splitwise" | …
  fileName      String
  importedCount Int          @default(0)
  skippedCount  Int          @default(0)
  errors        Json?
  // Entities this batch brought into existence, so undo can reverse them:
  // {"accounts":[id,…],"categories":[id,…]}. Only the backup-restore engine
  // creates entities — the CSV import maps onto existing ones — so this is
  // null for every CSV batch. Undo deletes these only while still unreferenced.
  createdEntities Json?
  status        ImportStatus @default(PREVIEW)
  createdAt     DateTime     @default(now())
  // undo = soft-delete all tx where importBatchId = id, then drop createdEntities

  @@index([userId])
}

model ImportMapping {
  id          String @id @default(cuid())
  userId      String
  source      String
  columnMap   Json // {"Date":"occurredAt","Note":"merchant",…}
  categoryMap Json // {"Eating Out":"Food",…}

  @@unique([userId, source])
}

model AuditLog {
  id          String   @id @default(cuid())
  userId      String // whose ledger this is filed under — unchanged meaning
  action      String
  entity      String
  entityId    String
  before      Json?
  after       Json?
  at          DateTime @default(now())
  // collaboration-architecture-rfc §5: who actually performed the action,
  // when it differs from whose ledger it's filed under (a group co-member
  // editing someone else's transaction). Null means "acted by userId
  // themself" — true for every row written before this column existed and
  // for all personal-transaction writes going forward.
  actorUserId String?

  @@index([userId, at(sort: Desc)])
  @@index([entityId])
}
